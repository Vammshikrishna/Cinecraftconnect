{
  "name": "cinecraft-connect",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cinecraft/web",
    "dev:web": "npm run dev --workspace=@cinecraft/web",
    "build": "npm run build --workspace=@cinecraft/web",
    "build:web": "npm run build --workspace=@cinecraft/web",
    "start:mobile": "npm run start --workspace=@cinecraft/mobile",
    "android": "npm run android --workspace=@cinecraft/mobile",
    "ios": "npm run ios --workspace=@cinecraft/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace=@cinecraft/web",
    "postinstall": "node scripts/patch-quick-crypto.cjs"
  },
  "devDependencies": {
    "vite": "^6.4.5",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "expo": "52.0.49",
    "image-size": "file:./vendor/image-size",
    "process": "^0.11.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "util": "^0.12.5"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "event-target-shim": "5.0.1",
    "@livekit/react-native-webrtc": {
      "event-target-shim": "6.0.2"
    },
    "@craftzdog/react-native-buffer": "6.0.5",
    "react-native-quick-base64": "2.1.2",
    "expo": "52.0.49",
    "tar": "^7.5.22",
    "@xmldom/xmldom": "^0.8.15",
    "send": "^0.19.2",
    "postcss": "^8.5.31",
    "fast-xml-parser": "^5.11.2",
    "uuid": "^11.1.1",
    "decode-uri-component": "$decode-uri-component",
    "image-size": "$image-size"
  }
}
