{
  "name": "cinecraft-connect",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cinecraft/web",
    "dev:web": "npm run dev --workspace=@cinecraft/web",
    "build": "npm run build --workspace=@cinecraft/web",
    "build:web": "npm run build --workspace=@cinecraft/web",
    "start:mobile": "npm run start --workspace=@cinecraft/mobile",
    "android": "npm run android --workspace=@cinecraft/mobile",
    "ios": "npm run ios --workspace=@cinecraft/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace=@cinecraft/web",
    "postinstall": "node scripts/patch-quick-crypto.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "process": "^0.11.10",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "util": "^0.12.5"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "event-target-shim": "5.0.1",
    "@livekit/react-native-webrtc": {
      "event-target-shim": "5.0.1"
    },
    "@craftzdog/react-native-buffer": "6.0.5",
    "react-native-quick-base64": "2.1.2"
  }
}
