<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS/WSS only, and only the system certificate store is trusted (user-installed CAs, as used by
     interception proxies, are NOT accepted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
