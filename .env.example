# CineCraft Connect — Environment Variables
# Copy this file to .env and fill in the values.

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# ── LiveKit ─────────────────────────────────────────────────────────────────
VITE_LIVEKIT_URL=wss://<your-livekit-host>

# ── TMDB ────────────────────────────────────────────────────────────────────
VITE_TMDB_API_KEY=<your-tmdb-api-key>

# ── Sentry (optional — client-side error reporting) ─────────────────────────
VITE_SENTRY_DSN=<your-sentry-dsn>

# ── Upstash Redis (Edge-native rate limiting) ────────────────────────────────
# Used by: supabase/functions/rate-limit-check
# Set via: supabase secrets set UPSTASH_REDIS_REST_URL=...
#           supabase secrets set UPSTASH_REDIS_REST_TOKEN=...
# For local function dev only (never commit the real values):
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>
